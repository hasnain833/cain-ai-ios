# packages/database/.env.example
# Copy to .env and fill in real values. Never commit .env.

# ── Supabase Postgres connection URLs ──────────────────────────
# Pooled connection — used by the app at runtime (with pgBouncer)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct connection — used by Prisma migrations only (not pgBouncer)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── Supabase Admin (for seed script only) ──────────────────────
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Seed credentials ───────────────────────────────────────────
# The email + password for the first SUPER_ADMIN user
SEED_USER_EMAIL="hasnainaftab87@gmail.com"
SEED_USER_PASSWORD="H@s4276246"
